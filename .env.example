# Token from @BotFather
BOT_TOKEN=

# The group's time zone
TIMEZONE=Europe/Amsterdam

# Which weekdays to offer for meetups (0 = Mon … 6 = Sun). Default: weekends only.
MEETING_WEEKDAYS=5,6

# Day of the month (1-28) when the bot posts the poll for next month
POLL_DAY=20
POLL_TIME=11:00

# Daily reminder for members who haven't voted yet
REMINDER_TIME=18:00

# Daily playful good-night message; set to "off" to disable
GOODNIGHT_TIME=23:00

# Chat assistant: Gigi answers when mentioned or replied to. Leave LLM_API_KEY empty to turn it off.
# Default is Google Gemini (free key: https://aistudio.google.com/apikey); any OpenAI-compatible API works.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Comma-separated, tried in order: if one is overloaded, the next one answers
# LLM_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Max answers per chat per day, to stay within the free tier
LLM_DAILY_LIMIT=50

# Poll durations
DATE_POLL_DAYS=3
ACTIVITY_POLL_HOURS=48

# Where to store the SQLite file (the Docker image uses /data)
# DB_PATH=girls_agent.sqlite3
