# Token from @BotFather
BOT_TOKEN=

# The group's time zone
TIMEZONE=Europe/Amsterdam

# Which weekdays to offer for meetups (0 = Mon … 6 = Sun). Default: weekends only.
MEETING_WEEKDAYS=5,6

# Day of the month (1-28) when the bot posts the poll for next month
POLL_DAY=20
POLL_TIME=11:00

# Daily reminder for members who haven't voted yet
REMINDER_TIME=18:00

# Daily playful good-night message, off by default; set a time like 23:00 to enable
# GOODNIGHT_TIME=23:00

# Daily morning message: a wish, the top science or tech story and the weather.
# Off by default; set a time like 07:00 to enable. Without LLM_API_KEY it's just a greeting with the weather.
# MORNING_TIME=07:00
# WEATHER_CITY=Амстердам
# WEATHER_LAT=52.37
# WEATHER_LON=4.90
# Comma-separated RSS feeds the story is picked from
# NEWS_FEEDS=https://feeds.bbci.co.uk/news/science_and_environment/rss.xml,https://feeds.bbci.co.uk/news/technology/rss.xml

# Whitelist: comma-separated group chat ids the bot works in, e.g. -1001234567890.
# Updates from any other chat get no reply, and other groups are left right away. Private chats work
# only for members of these groups. Empty = any chat; the startup log then lists the known chat ids.
ALLOWED_CHATS=

# Chat assistant: Gigi answers when mentioned or replied to. Leave LLM_API_KEY empty to turn it off.
# Default is Google Gemini (free key: https://aistudio.google.com/apikey); any OpenAI-compatible API works.
LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Comma-separated, tried in order: if one is overloaded or out of quota, the next one answers.
# Each free-tier model has its own daily limit, so the list adds them up.
# LLM_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash
# Max answers per chat per day, to stay within the free tier
LLM_DAILY_LIMIT=50
# What Gigi knows about the group and its members: copy group.example.txt to group.txt and fill it in.
# It's about real people, so group.txt stays out of git. Edits apply without a restart.
# GROUP_FILE=group.txt

# Poll durations
DATE_POLL_DAYS=3
ACTIVITY_POLL_HOURS=48

# Where to store the SQLite file (the Docker image uses /data)
# DB_PATH=girls_agent.sqlite3
